# Test binaries and profiles
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# Materialised corpus scales that are pinned by MANIFEST.sha256 but not stored.
# See the README: regenerating all three takes about 1.5 seconds, so committing
# 12.7 MB and ~250 MB to save that is a bad trade. small.json *is* committed and
# must not be ignored.
corpusdata/data/medium.json
corpusdata/data/large.json
plans/

# Tool binaries fetched by tools/*.sh.
tools/bin/

# Downloaded datasets: scripts and checksums are committed, the data is not.
datasets/data/

# lambda/deploy.py output.
lambda/build/
lambda/results/
__pycache__/

# reproduce.sh, bench/local.sh and web/run.mjs output. Every run is ignored but
# the paper's: a run written to results/paper-vN is the one the tag paper-vN
# carries, committed as reproduce.sh left it (RELEASING.md, step 2).
results/*
!results/paper-v*/

# The paper's build: main.pdf and LaTeX's files, and tables/, a copy of the
# run's (make -C paper RUN=...).
paper/tables/
paper/build/
paper/main.pdf
paper/main.aux
paper/main.bbl
paper/main.blg
paper/main.log
paper/main.fls
paper/main.fdb_latexmk

# cmd/webfixtures output and the browser page bundle.
web/fixtures/
web/node_modules/
web/bench/dist/
web/gen/

# cloud/ec2.py: state (the key pair) and the payload.
cloud/state/
cloud/build/
