# The paper. Everything numeric in it comes from one results directory:
#
#   make RUN=../results/<run>     copy that run's tables here and build main.pdf
#   make                          build with the tables already in tables/
#   make arxiv                    build, then pack what arXiv needs into build/arxiv.tar.gz
#   make clean
#
# RUN is a directory reproduce.sh wrote; its tables/ is regenerated by
# cmd/summary first, so a change to the summary shows without measuring again.
# arXiv does not run BibTeX: the archive carries main.bbl (RELEASING.md, step 5).
#
# TEX is latexmk with pdflatex when there is one, and tectonic otherwise
# (tools/fetch-tectonic.sh). arXiv compiles with pdflatex, so the PDF to check
# before submitting is a pdflatex one.

RUN ?=
TECTONIC := $(firstword $(wildcard ../tools/bin/tectonic) $(shell command -v tectonic 2>/dev/null))
SOURCES := main.tex related-work.bib $(wildcard sections/*.tex) $(wildcard tables/*)

main.pdf: tables $(SOURCES)
ifneq ($(shell command -v latexmk 2>/dev/null),)
	latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex
else ifneq ($(TECTONIC),)
	$(TECTONIC) --keep-intermediates --keep-logs main.tex
else
	@echo "no latexmk and no tectonic: install TeX Live, or run ../tools/fetch-tectonic.sh" >&2; exit 1
endif
	@! grep -E "Warning: (Reference|Citation)|no (result|table) '" main.log || \
		{ echo "main.log has undefined references, citations or results (above)" >&2; exit 1; }

# The tables of RUN, regenerated and copied; or the ones already here.
.PHONY: tables
tables:
ifneq ($(RUN),)
	cd .. && go run ./cmd/summary $(abspath $(RUN))
	rm -rf tables && cp -r $(abspath $(RUN))/tables tables
else
	@test -f tables/numbers.tex || { echo "no tables/: make RUN=../results/<run>" >&2; exit 1; }
endif

.PHONY: arxiv
arxiv: main.pdf
	@# What arXiv announces cannot be withdrawn, source included: nothing
	@# unfinished goes into the archive.
	@! grep -nE '\\recheck\{|TODO|<full hash>|<zenodo-doi>|^\\finalfalse' main.tex sections/*.tex || \
		{ echo "unfinished text above: resolve it (RELEASING.md, steps 2 and 4) before packing" >&2; exit 1; }
	@! grep -n 'resultdef{provisional}{.' tables/numbers.tex || \
		{ echo "tables/ is a provisional run's: not the paper's numbers" >&2; exit 1; }
	rm -rf build && mkdir -p build/arxiv/sections build/arxiv/tables
	cp main.bbl build/arxiv/
	@# The source is archived as uploaded, so whole-line comments stay here.
	@# A % that ends a line of text is TeX, not a comment, and is kept.
	for f in main.tex sections/*.tex; do grep -v '^[[:space:]]*%' $$f > build/arxiv/$$f; done
	@# Only the tables, numbers and figure data the text reads: arXiv flags
	@# files a submission does not use, and a run writes many more.
	for f in tables/*; do \
		stem=$$(basename $$f); stem=$${stem%.*}; \
		if grep -qF -- "$$stem" main.tex sections/*.tex; then grep -v '^[%#] Generated by' $$f > build/arxiv/$$f; fi; \
	done
	@# arXiv accepts only these characters in a file name.
	@! find build/arxiv -type f | grep -vE '^[a-zA-Z0-9_+.,=/-]+$$' || \
		{ echo "file names above are not ones arXiv accepts" >&2; exit 1; }
ifneq ($(shell command -v pdflatex 2>/dev/null),)
	@# The archive alone, as arXiv will compile it: pdflatex, no BibTeX.
	cd build/arxiv && pdflatex -interaction=nonstopmode -halt-on-error main.tex >/dev/null && \
		pdflatex -interaction=nonstopmode -halt-on-error main.tex >/dev/null && \
		! grep -E "Warning: (Reference|Citation)|no (result|table) '" main.log && \
		rm -f main.aux main.log main.out main.pdf
else
	@echo "no pdflatex here: the archive was not compiled on its own; arXiv's preview is the first test of it" >&2
endif
	tar -czf build/arxiv.tar.gz -C build/arxiv .
	@echo "build/arxiv.tar.gz: upload it, and read the PDF arXiv compiles before confirming"

.PHONY: clean
clean:
	rm -rf build main.pdf main.aux main.bbl main.blg main.log main.out main.fls main.fdb_latexmk
